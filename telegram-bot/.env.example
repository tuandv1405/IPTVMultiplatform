# TS IPTV contributor server — copy to .env and fill in. Never commit .env.
# Only needed for the own-server phase (VPS / physical machine / Cloud Run).
# While the web runs on BACKEND = "firestore", nothing here is required.
# Every variable is explained in README.md.

# ---- Storage ---------------------------------------------------------------
# sqlite    — own server (default): one file, back it up.
# firestore — Cloud Run: the same collections the web used in the Firestore phase.
# memory    — tests / dry runs only (refused with NODE_ENV=production).
STORE_DRIVER=sqlite
SQLITE_PATH=./data/contributors.sqlite

# ---- Admins ------------------------------------------------------------------
# Google accounts that may use the admin console / admin API. Keep in sync with
# firestore.rules and web/public/assets/contributor-config.js. The `admin`
# custom claim (npm run set-admin <email>) also counts.
ADMIN_EMAILS=chintk111999@gmail.com

# Optional: the contact PRIVATE key (from npm run gen-contact-keypair) lets the
# Telegram /contact command decrypt contributors' name/email/phone. Without it,
# admins decrypt in the web console by loading the key file there.
CONTACT_PRIVATE_KEY_FILE=

# ---- Telegram ----------------------------------------------------------------
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# polling — own server (outbound connection only, no public URL needed)
# webhook — Cloud Run or any host with a public https URL
# off     — no Telegram at all (the admin console is enough)
TELEGRAM_MODE=polling

# Admins get every new request and playlist in a private chat and are the only
# ones who can take down, suspend and read contact data. An admin must open the
# bot and press Start once, otherwise Telegram does not let the bot message them.
TELEGRAM_ADMIN_USERNAMES=tuandv1405
# Numeric user IDs, comma-separated (send /whoami to the bot to see yours).
TELEGRAM_ADMIN_CHAT_IDS=

# The moderation group: add the bot, send /whoami there, paste the negative number.
# Every member of this group can approve or reject.
TELEGRAM_REVIEW_CHAT_ID=

# Webhook mode only: public base URL (no trailing slash) and a random secret
# (npm run gen-keys prints one).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ---- Firebase (identity stays with Firebase Auth / Google sign-in) ----------
FIREBASE_PROJECT_ID=tsiptv-8bdd6
# Own server: a service-account key with "Firebase Authentication Viewer" (and
# "Cloud Datastore User" if STORE_DRIVER=firestore). Not needed on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- HTTP API ----------------------------------------------------------------
PORT=8080
# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=https://tsiptv-8bdd6.web.app,https://tsiptv-8bdd6.firebaseapp.com
# true behind a reverse proxy / Cloud Run, so rate limits see the real client IP.
TRUST_PROXY=false
# Number of proxies that append to X-Forwarded-For in front of the service.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=30

NODE_ENV=production
LOG_LEVEL=info

# Local testing only: accept "dev:" tokens instead of Firebase ID tokens.
# Refused when NODE_ENV=production.
ALLOW_DEV_AUTH=false
