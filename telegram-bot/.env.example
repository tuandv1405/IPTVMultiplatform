# TS IPTV contributor bot — copy to .env and fill in. Never commit .env.
# Every variable is explained in README.md.

# ---- Telegram ---------------------------------------------------------------
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# polling  — local machine or VPS (outbound connection only, no public URL needed)
# webhook  — Google Cloud Run or any host with a public https URL
# off      — API only, no Telegram (debugging)
TELEGRAM_MODE=polling

# Admins get every new playlist in a private chat and are the only ones who can
# take down, ban and read contact data. Usernames are matched without "@".
# An admin must open the bot and press Start (or send /whoami) once, otherwise
# Telegram does not let the bot message them.
TELEGRAM_ADMIN_USERNAMES=tuandv1405
# Numeric user IDs, comma-separated (send /whoami to the bot to see yours).
TELEGRAM_ADMIN_CHAT_IDS=

# The moderation group. Add the bot to the group, send /whoami there, paste the
# negative number here. Every member of this group can approve or reject.
TELEGRAM_REVIEW_CHAT_ID=

# Webhook mode only: the service's public base URL (no trailing slash) and a
# random secret (npm run gen-keys prints one).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ---- Personal data encryption ----------------------------------------------
# Two different 32-byte keys, base64. Generate with: npm run gen-keys
# BACK THEM UP. Losing PII_ENCRYPTION_KEY makes stored emails/phones unreadable.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# ---- Firebase ----------------------------------------------------------------
FIREBASE_PROJECT_ID=tsiptv-8bdd6
# Local / VPS: path to a service-account key with the "Cloud Datastore User"
# and "Firebase Authentication Viewer" roles. Not needed on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# firestore (default) or memory (local dry run; everything is lost on exit)
STORE_DRIVER=firestore

# ---- HTTP API ----------------------------------------------------------------
PORT=8080
# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=https://tsiptv-8bdd6.web.app,https://tsiptv-8bdd6.firebaseapp.com
# true behind a reverse proxy / Cloud Run, so rate limits see the real client IP.
TRUST_PROXY=false
# Number of proxies that append to X-Forwarded-For in front of the service (1 for Caddy/nginx/Cloud Run).
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=30

NODE_ENV=production
LOG_LEVEL=info

# Local testing only: accept "dev:" tokens instead of Firebase ID tokens.
# Refused when NODE_ENV=production.
ALLOW_DEV_AUTH=false
