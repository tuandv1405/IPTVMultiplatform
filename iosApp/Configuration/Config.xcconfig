// CocoaPods (MobileVLCKit) settings. Its Debug and Release files are identical. CocoaPods cannot
// see this file (an Xcode 16 synchronized-group base configuration), so the Podfile's
// post_integrate hook keeps this file as the target's base and it includes the Pods settings.
#include? "../Pods/Target Support Files/Pods-iosApp/Pods-iosApp.release.xcconfig"

// MobileVLCKit also exports libc's clock_gettime and its own zlib, libpng, FFmpeg and more.
// With the framework on the link line, ld-prime bound some of the app's calls to those copies,
// and not the same way on every link: Skia called VLCKit's png_destroy_read_struct (crash on the
// first PNG) and gRPC got VLCKit's clock_gettime (Firestore abort at launch). So the app links
// against VLCKitLinkStub/MobileVLCKit.tbd, which lists only the VLC* API (regenerate it with
// VLCKitLinkStub/generate.py after a pod update). At run time dyld loads the real framework,
// which the Pods script embeds. These are the Pods flags without `-framework MobileVLCKit`;
// ComposeApp (otherwise auto-linked last) and libSystem come first.
OTHER_LDFLAGS = -lSystem -framework ComposeApp $(SRCROOT)/VLCKitLinkStub/MobileVLCKit.tbd -ObjC -l"bz2" -l"c++" -l"iconv" -l"xml2" -l"z" -framework "AVFoundation" -framework "AudioToolbox" -framework "CFNetwork" -framework "CoreGraphics" -framework "CoreMedia" -framework "CoreText" -framework "OpenGLES" -framework "QuartzCore" -framework "Security" -framework "VideoToolbox"

// The app supports iOS 15.6, but Kotlin/Native binds the iOS 16 classes it uses (behind
// version checks, e.g. UIWindowSceneGeometryPreferencesIOS) as hard imports: dyld refused to
// load the app on iOS 15. Weak-linking UIKit makes such a missing class nil instead.
OTHER_LDFLAGS = $(OTHER_LDFLAGS) -weak_framework UIKit

// `import MobileVLCKit` in Swift would auto-link the real framework again.
OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -disable-autolink-framework -Xfrontend MobileVLCKit

// Team ID for code signing (replace with your actual team ID)
TEAM_ID=57N5M3BU77

// App name and bundle identifier
PRODUCT_NAME=TSIPTV
PRODUCT_BUNDLE_IDENTIFIER=tss.t.tsiptv

// Version information
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Deployment target
IPHONEOS_DEPLOYMENT_TARGET=17.6
