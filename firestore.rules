rules_version = '2';

// TS IPTV — Cloud Firestore security rules.
//
// 1. users/{uid}/**: private per-user data of the app (unchanged).
// 2. The contributor programme (docs/prd-contributor-requests.md). While it runs
//    on Firestore, browsers write here directly, so these rules ARE the backend:
//    every limit the product promises is enforced below, not in the page.
//      contributor_requests/{uid}    one request per user, owner + admin read
//      contributors/{uid}            written only by admins
//      playlist_submissions/{id}     created only by ACTIVE contributors
//      playlist_submission_images/{id}, playlist_urls/{sha256}
//      public_playlists/{id}, public_playlist_images/{id}   world-readable
// 3. Everything else is denied.
//
// Tests: firestore-tests/ (npm test, against the emulator).
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isGoogle() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    // The Firebase project owner, plus anyone given the `admin` custom claim
    // (telegram-bot/scripts/set-admin-claim.js). Keep in sync with ADMIN_EMAILS
    // in web/public/assets/contributor-config.js.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (isGoogle() && request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in ['chintk111999@gmail.com'])
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function contributorPath(uid) {
      return /databases/$(database)/documents/contributors/$(uid);
    }

    function isActiveContributor() {
      return signedIn() && exists(contributorPath(request.auth.uid)) &&
        get(contributorPath(request.auth.uid)).data.status == 'ACTIVE';
    }

    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optionalLink(links, i) {
      return links.size() <= i || (links[i] is string && links[i].size() <= 500 && links[i].matches('^https?://.{3,}'));
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- 1. app user data -------------------------------------------------

    // The user document itself, and every subcollection the app owns freely
    // (e.g. deactiveRequest). The collections below have their own rules and
    // are excluded here, or this wildcard would grant them everything.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/{coll}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && !(coll in ['devices', 'meta', 'quota', 'sync']);
    }

    // ---- 1b. devices, quotas, sync (docs/prd-tv-cast-and-sync.md) ------------
    // Rules cannot count a collection, so meta/devices.ids is the list of
    // registered device ids (at most 4). A device is added or removed together
    // with its id, in one transaction.

    function devicesMetaPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/meta/devices;
    }

    function devicePath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/devices/$(id);
    }

    function validDevice(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'platform', 'name', 'appVersion', 'createdAt', 'lastSeen']) &&
        d.id == id && d.platform in ['android_phone', 'android_tv', 'ios', 'desktop'] &&
        text(d.name, 1, 60) && text(d.appVersion, 0, 40) &&
        d.createdAt is int && d.lastSeen is int;
    }

    function idsAfter(uid) {
      return getAfter(devicesMetaPath(uid)).data.ids;
    }

    function idsBefore(uid) {
      return exists(devicesMetaPath(uid)) ? get(devicesMetaPath(uid)).data.ids : [];
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      // Only together with its id in meta/devices (which caps the count).
      allow create: if isOwner(userId) && validDevice(deviceId) &&
        existsAfter(devicesMetaPath(userId)) && deviceId in idsAfter(userId);
      allow update: if isOwner(userId) && validDevice(deviceId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        deviceId in idsBefore(userId);
      // Signing a device out (own or remote) also removes its id.
      allow delete: if isOwner(userId) &&
        (!existsAfter(devicesMetaPath(userId)) || !(deviceId in idsAfter(userId)));
    }

    match /users/{userId}/meta/devices {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['ids', 'updatedAt']) &&
        request.resource.data.ids is list &&
        request.resource.data.ids.size() <= 4 &&
        request.resource.data.ids.toSet().size() == request.resource.data.ids.size() &&
        request.resource.data.updatedAt is int &&
        (
          // Add exactly one id, whose device document is created in the same write.
          (request.resource.data.ids.size() == idsBefore(userId).size() + 1 &&
            request.resource.data.ids.hasAll(idsBefore(userId)) &&
            existsAfter(devicePath(userId, request.resource.data.ids.removeAll(idsBefore(userId))[0])) &&
            !exists(devicePath(userId, request.resource.data.ids.removeAll(idsBefore(userId))[0]))) ||
          // Remove exactly one id, whose device document is deleted in the same write.
          (request.resource.data.ids.size() == idsBefore(userId).size() - 1 &&
            idsBefore(userId).hasAll(request.resource.data.ids) &&
            !existsAfter(devicePath(userId, idsBefore(userId).removeAll(request.resource.data.ids)[0])))
        );
      allow delete: if false;
    }

    // Daily quotas (PRD §6). Without a backend these rules are the only guard:
    // counters only grow (by at most 1 per write) within a day, stay under the
    // caps, and the document can never be deleted to reset them.
    //
    // Known limit (accepted for v1, needs server verification later): the rules
    // cannot know whether a rewarded ad was really watched. A client can raise
    // syncRewards (or sendRewards) without watching anything, e.g. syncRewards
    // without syncAds ever reaching 1. The caps still bound it: at most 2 extra
    // syncs and 5 extra sends a day. Only AdMob server-side verification to a
    // Cloud Function that alone may raise *Rewards closes this (PRD §6, §8).
    function dayOf(t) {
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // The client counts by its local date (QuotaPolicy.dayKey). Accepted: the calendar
    // day (UTC) at request.time - 11 h or at request.time + 13 h, i.e. local time zones
    // UTC-11 .. UTC+13 (every inhabited zone except UTC+13:45 / +14; writes from those
    // fail and the app then reports the send as not counted). Window math: the two
    // ends are exactly 24 h apart, so at any instant at most TWO days are acceptable
    // (dayOf(t) is always one of them), and the newest acceptable day only moves on
    // once per 24 h. Days only go forward (update rule below). So by jumping from the
    // older to the newer acceptable day a client can open at most ONE extra day's
    // quota, once; it can never open a day further ahead (the old ±14 h window, 28 h
    // wide, allowed three days at once: two extra).
    function plausibleDay(d) {
      return d is int && (d == dayOf(request.time - duration.value(11, 'h')) ||
        d == dayOf(request.time + duration.value(13, 'h')));
    }

    // networks: at most 10 network ids (12 hex characters, see LanValidation.networkId).
    // Rules cannot loop, so every possible index is checked.
    function netOk(l, i) {
      return l.size() <= i || (l[i] is string && l[i].size() >= 1 && l[i].size() <= 16);
    }

    function validNetworks(l) {
      return l is list && l.size() <= 10 &&
        netOk(l, 0) && netOk(l, 1) && netOk(l, 2) && netOk(l, 3) && netOk(l, 4) &&
        netOk(l, 5) && netOk(l, 6) && netOk(l, 7) && netOk(l, 8) && netOk(l, 9);
    }

    function step(n, old) {
      return n is int && n >= old && n <= old + 1;
    }

    function quotaPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/quota/daily;
    }

    function validQuota() {
      let q = request.resource.data;
      return q.keys().hasOnly(['day', 'sends', 'sendRewards', 'syncs', 'syncRewards', 'syncAds', 'networks', 'updatedAt']) &&
        q.keys().hasAll(['day', 'sends', 'sendRewards', 'syncs', 'syncRewards', 'syncAds', 'networks', 'updatedAt']) &&
        plausibleDay(q.day) && q.updatedAt is int &&
        validNetworks(q.networks) &&
        q.sendRewards <= 5 && q.sends <= 3 + q.sendRewards &&
        q.syncRewards <= 2 && q.syncs <= 1 + q.syncRewards &&
        q.syncAds is int && q.syncAds >= 0 && q.syncAds <= 1;
    }

    // A fresh day: every counter starts at 0 and this write adds at most 1.
    function freshQuota() {
      let q = request.resource.data;
      return step(q.sends, 0) && step(q.sendRewards, 0) && step(q.syncs, 0) && step(q.syncRewards, 0);
    }

    match /users/{userId}/quota/daily {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validQuota() && freshQuota();
      allow update: if isOwner(userId) && validQuota() && (
        (request.resource.data.day == resource.data.day &&
          step(request.resource.data.sends, resource.data.sends) &&
          step(request.resource.data.sendRewards, resource.data.sendRewards) &&
          step(request.resource.data.syncs, resource.data.syncs) &&
          step(request.resource.data.syncRewards, resource.data.syncRewards)) ||
        (request.resource.data.day > resource.data.day && freshQuota())
      );
      allow delete: if false;
    }

    // The account's sync slot: owner only, written only by a registered device
    // and only together with one more counted sync in the quota document.
    match /users/{userId}/sync/current {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['v', 'fromDeviceId', 'fromDeviceName', 'createdAt', 'playlistCount', 'payload']) &&
        request.resource.data.v == 1 &&
        text(request.resource.data.fromDeviceName, 1, 60) &&
        request.resource.data.createdAt is int &&
        request.resource.data.playlistCount is int && request.resource.data.playlistCount <= 100 &&
        text(request.resource.data.payload, 2, 262144) &&
        exists(devicesMetaPath(userId)) &&
        request.resource.data.fromDeviceId in get(devicesMetaPath(userId)).data.ids &&
        getAfter(quotaPath(userId)).data.syncs ==
          ((exists(quotaPath(userId)) && get(quotaPath(userId)).data.day == getAfter(quotaPath(userId)).data.day)
            ? get(quotaPath(userId)).data.syncs + 1 : 1);
      allow delete: if isOwner(userId);
    }

    // ---- 2a. requests to become a contributor ----------------------------

    function validContact(c) {
      return c is map && c.keys().hasAll(['v', 'alg', 'kid', 'wrappedKey', 'iv', 'ct']) &&
        c.keys().hasOnly(['v', 'alg', 'kid', 'wrappedKey', 'iv', 'ct']) &&
        c.v == 1 && c.alg == 'RSA-OAEP-256+A256GCM' && text(c.kid, 8, 64) &&
        text(c.wrappedKey, 100, 2048) && text(c.iv, 12, 32) && text(c.ct, 20, 4096);
    }

    function validConsents(c) {
      return c is map && c.keys().hasAll(['policy', 'terms', 'privacy', 'acceptedAt']) &&
        c.keys().hasOnly(['policy', 'terms', 'privacy', 'acceptedAt']) &&
        text(c.policy, 4, 20) && text(c.terms, 4, 20) && text(c.privacy, 4, 20) &&
        c.acceptedAt == request.time;
    }

    // A complete, fresh request written by its owner.
    function validRequest(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'publicName', 'about', 'links', 'contactEnc', 'consents', 'status', 'attempt', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly(['uid', 'publicName', 'about', 'links', 'contactEnc', 'consents', 'status', 'attempt', 'createdAt', 'updatedAt']) &&
        d.uid == uid && d.status == 'PENDING' &&
        text(d.publicName, 2, 40) && text(d.about, 20, 1000) &&
        d.links is list && d.links.size() <= 3 &&
        optionalLink(d.links, 0) && optionalLink(d.links, 1) && optionalLink(d.links, 2) &&
        validContact(d.contactEnc) && validConsents(d.consents) &&
        d.attempt is int && d.createdAt == request.time && d.updatedAt == request.time;
    }

    match /contributor_requests/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // First request. The document ID is the UID, so a user can never hold two.
      // A contributor record (active or suspended) means the user was approved
      // already: applying again must not be a way round a suspension.
      allow create: if isOwner(uid) && isGoogle() && validRequest(uid) && request.resource.data.attempt == 1 &&
        !exists(contributorPath(uid));

      allow update: if
        // The owner may apply again only after a rejection (never while PENDING,
        // never after APPROVED).
        (isOwner(uid) && isGoogle() && resource.data.status == 'REJECTED' && validRequest(uid) &&
          request.resource.data.attempt == resource.data.attempt + 1 && !exists(contributorPath(uid))) ||
        // An admin decides a pending request. Approval must create the
        // contributor in the same batch.
        (isAdmin() && resource.data.status == 'PENDING' &&
          changed().hasOnly(['status', 'decision', 'updatedAt']) &&
          request.resource.data.status in ['APPROVED', 'REJECTED'] &&
          request.resource.data.decision.keys().hasOnly(['by', 'name', 'at', 'reason']) &&
          request.resource.data.decision.by == request.auth.uid &&
          request.resource.data.decision.at == request.time &&
          text(request.resource.data.decision.reason, 0, 500) &&
          request.resource.data.updatedAt == request.time &&
          (request.resource.data.status == 'REJECTED' ||
            getAfter(contributorPath(uid)).data.status == 'ACTIVE'));

      // Cancelling a request, or deleting the account (the request holds the
      // encrypted contact data). Admins may clean up.
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---- 2b. contributors ---------------------------------------------------

    match /contributors/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Created only together with an approved request, never over an existing
      // (e.g. suspended) contributor, and with the name the user asked for.
      allow create, update: if isAdmin() && (
        (resource == null &&
          request.resource.data.keys().hasOnly(['uid', 'publicName', 'status', 'approvedAt', 'approvedBy', 'updatedAt']) &&
          request.resource.data.uid == uid && request.resource.data.status == 'ACTIVE' &&
          request.resource.data.publicName == getAfter(/databases/$(database)/documents/contributor_requests/$(uid)).data.publicName &&
          request.resource.data.approvedBy == request.auth.uid &&
          request.resource.data.approvedAt == request.time &&
          getAfter(/databases/$(database)/documents/contributor_requests/$(uid)).data.status == 'APPROVED') ||
        // Suspend / reinstate.
        (resource != null && changed().hasOnly(['status', 'statusNote', 'updatedAt']) &&
          request.resource.data.status in ['ACTIVE', 'SUSPENDED'] &&
          text(request.resource.data.statusNote, 0, 300) &&
          request.resource.data.updatedAt == request.time)
      );
      allow delete: if isAdmin();
    }

    // ---- 2c. playlist submissions -------------------------------------------

    function submissionPath(id) {
      return /databases/$(database)/documents/playlist_submissions/$(id);
    }

    function validSubmission(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'ownerUid', 'publicName', 'name', 'url', 'urlHash', 'description', 'category', 'language', 'declarations', 'verification', 'status', 'statusReason', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly(['id', 'ownerUid', 'publicName', 'name', 'url', 'urlHash', 'description', 'category', 'language', 'declarations', 'verification', 'status', 'statusReason', 'createdAt', 'updatedAt']) &&
        d.id == id && d.ownerUid == request.auth.uid &&
        d.publicName == get(contributorPath(request.auth.uid)).data.publicName &&
        text(d.name, 3, 80) && text(d.url, 10, 2048) && normalisedUrl(d.url) &&
        // The lock key is derived from the link here, not trusted from the client.
        d.urlHash == hashing.sha256(d.url).toHexString().lower() &&
        text(d.description, 0, 500) &&
        d.category in ['general', 'news', 'sports', 'movies', 'kids', 'music', 'documentary', 'education', 'religious', 'regional', 'other'] &&
        d.language is string && d.language.matches('^([a-z]{2,3}|multi)$') &&
        d.declarations.keys().hasOnly(['own_work', 'not_copied', 'rights_ok', 'policyVersion']) &&
        d.declarations.own_work == true && d.declarations.not_copied == true && d.declarations.rights_ok == true &&
        text(d.declarations.policyVersion, 4, 20) &&
        validBrowserCheck(d.verification) &&
        d.status == 'IN_REVIEW' && d.statusReason == null &&
        d.createdAt == request.time && d.updatedAt == request.time;
    }

    // The form normaliseUrl() in contributor-backend.js produces, so that one link
    // has one spelling and therefore one lock: lower-case host, no user info, no
    // default port, a path, no fragment, no "." / ".." path segments.
    function normalisedUrl(u) {
      return u.matches('https?://[a-z0-9.-]*[a-z0-9](:[1-9][0-9]{0,4})?/[^#\\s]*') &&
        !u.matches('https://[^/]+:443/.*') && !u.matches('http://[^/]+:80/.*') &&
        !u.matches('[^?]*/[.]{1,2}(/[^?]*)?([?].*)?') &&
        !u.matches('[^?]*%2[eE].*') &&
        !u.matches('https?://[^/]+[^?]*//.*') &&
        !u.matches('.*[?]');
    }

    function optionalCount(v) {
      return v == null || (v is int && v >= 0 && v <= 100000);
    }

    // What the browser could check. Self-reported, so bounded and marked as such.
    function validBrowserCheck(v) {
      return v == null || (v is map &&
        v.keys().hasOnly(['ok', 'method', 'format', 'channelCount', 'groupCount']) &&
        v.method == 'browser' &&
        (v.get('ok', null) == null || v.ok is bool) &&
        (v.get('format', null) == null || v.format in ['m3u', 'xspf', 'json']) &&
        optionalCount(v.get('channelCount', null)) && optionalCount(v.get('groupCount', null)));
    }

    match /playlist_submissions/{id} {
      allow get: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      // Queries must filter on ownerUid == own uid; admins may list everything.
      allow list: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();

      // Only ACTIVE contributors, and only together with the image and the link lock.
      allow create: if isActiveContributor() && validSubmission(id) &&
        existsAfter(/databases/$(database)/documents/playlist_submission_images/$(id)) &&
        getAfter(/databases/$(database)/documents/playlist_urls/$(request.resource.data.urlHash)).data.submissionId == id;

      allow update: if
        // The owner withdraws. An approved one must leave the public directory in the same batch.
        (signedIn() && resource.data.ownerUid == request.auth.uid &&
          resource.data.status in ['IN_REVIEW', 'APPROVED'] &&
          request.resource.data.status == 'WITHDRAWN' &&
          changed().hasOnly(['status', 'statusReason', 'updatedAt']) &&
          request.resource.data.statusReason == {'code': 'withdrawn'} &&
          request.resource.data.updatedAt == request.time &&
          !existsAfter(/databases/$(database)/documents/public_playlists/$(id)) &&
          !existsAfter(/databases/$(database)/documents/public_playlist_images/$(id))) ||
        // An admin decides: approve / reject a submission in review, take down an approved one.
        (isAdmin() &&
          changed().hasOnly(['status', 'statusReason', 'review', 'updatedAt']) &&
          request.resource.data.review.by == request.auth.uid &&
          request.resource.data.review.at == request.time &&
          request.resource.data.updatedAt == request.time &&
          ((resource.data.status == 'IN_REVIEW' && request.resource.data.status == 'APPROVED' &&
              existsAfter(/databases/$(database)/documents/public_playlists/$(id))) ||
           (resource.data.status == 'IN_REVIEW' && request.resource.data.status == 'REJECTED') ||
           (resource.data.status == 'APPROVED' && request.resource.data.status == 'REMOVED' &&
              !existsAfter(/databases/$(database)/documents/public_playlists/$(id)) &&
              !existsAfter(/databases/$(database)/documents/public_playlist_images/$(id)))));

      allow delete: if false;
    }

    match /playlist_submission_images/{id} {
      allow get: if isAdmin() || (signedIn() && get(submissionPath(id)).data.ownerUid == request.auth.uid);
      allow list: if false;
      // Only in the batch that creates its submission.
      allow create: if isActiveContributor() && !exists(submissionPath(id)) &&
        getAfter(submissionPath(id)).data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['mime', 'data']) &&
        request.resource.data.mime in ['image/png', 'image/jpeg', 'image/webp'] &&
        text(request.resource.data.data, 100, 420000);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Link locks: one contributor per playlist link. The ID is sha256 of the
    // normalised link. Anyone signed in may check whether a link is taken.
    match /playlist_urls/{hash} {
      allow get: if isActiveContributor() || isAdmin();
      allow list: if false;
      allow create: if isActiveContributor() &&
        request.resource.data.keys().hasOnly(['submissionId', 'ownerUid']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        !exists(submissionPath(request.resource.data.submissionId)) &&
        getAfter(submissionPath(request.resource.data.submissionId)).data.urlHash == hash;
      allow update: if false;
      // Released when the owner withdraws, or by an admin.
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid &&
          getAfter(submissionPath(resource.data.submissionId)).data.status == 'WITHDRAWN');
    }

    // ---- 2d. public directory ---------------------------------------------------

    match /public_playlists/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && getAfter(submissionPath(id)).data.status == 'APPROVED' &&
        request.resource.data.keys().hasOnly(['id', 'name', 'url', 'description', 'category', 'language', 'publicName', 'channelCount', 'groupCount', 'format', 'approvedAt']) &&
        request.resource.data.id == id;
      allow delete: if isAdmin() ||
        (signedIn() && get(submissionPath(id)).data.ownerUid == request.auth.uid &&
          getAfter(submissionPath(id)).data.status == 'WITHDRAWN');
    }

    match /public_playlist_images/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && getAfter(submissionPath(id)).data.status == 'APPROVED';
      allow delete: if isAdmin() ||
        (signedIn() && get(submissionPath(id)).data.ownerUid == request.auth.uid &&
          getAfter(submissionPath(id)).data.status == 'WITHDRAWN');
    }

    // ---- 3. everything else -------------------------------------------------------
    // Also covers the collections the own-server backend uses when it runs on
    // Firestore (Admin SDK bypasses rules, browsers get nothing).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
