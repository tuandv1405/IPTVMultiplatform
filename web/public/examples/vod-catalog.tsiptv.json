  "meta": {
    "name": { "en": "Public Domain Cinema", "vi": "Rạp phim Phạm vi công cộng" },
    "description": {
      "en": "A small movie and series catalog built only from public-domain films on archive.org and a public test stream. It shows a custom appearance and home layout.",
      "vi": "Danh mục phim và phim bộ nhỏ, chỉ gồm phim thuộc phạm vi công cộng trên archive.org và một luồng thử nghiệm công khai. Tệp này minh hoạ giao diện và bố cục trang chủ tuỳ chỉnh."
    },
    "author": { "name": "TS IPTV examples", "url": "https://tsiptv-8bdd6.web.app/guides/tsiptv-source/" },
    "homepage": "https://tsiptv-8bdd6.web.app/guides/tsiptv-source/",
    "language": "en",
    "languages": ["en"],
    "updatedAt": "2026-09-27T00:00:00Z",
    "license": "Listing: CC0-1.0. Films: public domain (see each item)."
  },
  "appearance": {
    "accent": "#FFB300",
    "accentSecondary": "#FF7043",
    "background": { "gradient": ["#101014", "#1C1C24"] },
    "card": { "style": "poster", "corner": "large", "showTitles": true }
  },
  "layout": {
    "home": [
      {
        "type": "hero",
        "id": "featured",
        "items": [
          {
            "image": "https://archive.org/services/img/his_girl_friday",
            "title": "His Girl Friday",
            "subtitle": { "en": "Screwball comedy, 1940", "vi": "Hài kịch, 1940" },
            "target": "his-girl-friday"
          },
          {
            "image": "https://archive.org/services/img/superman_the_mechanical_monsters",
            "title": { "en": "Fleischer Superman", "vi": "Superman của Fleischer" },
            "subtitle": { "en": "Animated shorts, 1941–1943", "vi": "Phim hoạt hình ngắn, 1941–1943" },
            "target": "fleischer-superman"
          }
        ]
      },
      {
        "type": "row",
        "id": "continue",
        "title": { "en": "Continue watching", "vi": "Xem tiếp" },
        "query": { "from": "continueWatching" },
        "card": { "style": "landscape" }
      },
      {
        "type": "row",
        "id": "movies",
        "title": { "en": "Movies", "vi": "Phim lẻ" },
        "query": { "from": "movies", "sort": "yearDesc", "limit": 20 }
      },
      {
        "type": "row",
        "id": "series",
        "title": { "en": "Series", "vi": "Phim bộ" },
        "query": { "from": "series" }
      },
      {
        "type": "grid",
        "id": "comedy",
        "title": { "en": "Comedy", "vi": "Hài" },
        "query": { "from": "movies", "genres": ["Comedy"], "sort": "name" },
        "card": { "style": "landscape", "corner": "small" }
      }
    ]
  },
